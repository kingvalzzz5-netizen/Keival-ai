  <button class="rb" id="send" aria-label="Send">➤</button>
</form>
<script>
const $=id=>document.getElementById(id);
const chat=$('chat'),q=$('q'),orb=$('orb'),send=$('send'),chips=$('chips'),setup=$('setup'),keyIn=$('key'),mic=$('mic'),langBtn=$('lang');
const T={
id:{sub:"Tanya apa saja. Sentuh bintang, ketik, atau bicara.",ph:"Ketik pertanyaanmu di sini…",hello:"Halo! Saya KEIVAL AI. Sentuh bintang, pilih saran, ketik, atau tekan 🎤 untuk bicara.",
ideas:["Ceritakan fakta unik hari ini","Jelaskan AI dengan sederhana","Bantu saya buat ide bisnis","Beri saya semangat"],
setup:"Masukkan API key Anthropic kamu (dari console.anthropic.com). Key disimpan hanya di HP ini.",save:"Simpan",saved:"API key tersimpan. Silakan bertanya!",try:"Coba: ",err:"Maaf: ",
denied:"Izin mikrofon ditolak. Aktifkan lewat pengaturan HP.",na:"Pengenalan suara tidak tersedia di HP ini.",micErr:"Suara tidak terdengar. Coba lagi.",listen:"Mendengarkan…"},
en:{sub:"Ask me anything. Tap the star, type, or speak.",ph:"Type your question here…",hello:"Hello! I'm KEIVAL AI. Tap the star, pick a suggestion, type, or press 🎤 to speak.",
ideas:["Tell me a fun fact today","Explain AI in simple words","Help me with a business idea","Cheer me up"],
setup:"Enter your Anthropic API key (from console.anthropic.com). It is stored only on this phone.",save:"Save",saved:"API key saved. Ask me anything!",try:"Try: ",err:"Sorry: ",
denied:"Microphone permission denied. Enable it in phone settings.",na:"Speech recognition isn't available on this phone.",micErr:"Couldn't hear you. Try again.",listen:"Listening…"}};
const SR={id:"id-ID",en:"en-US"};
let lang=localStorage.getItem('lang')||'id',busy=false,micOn=false,nextId=1;
const history=[],pending={};
const t=()=>T[lang];
function add(x,c){const d=document.createElement('div');d.className='msg '+c;d.textContent=x;chat.appendChild(d);chat.scrollTop=chat.scrollHeight;return d}
function pulse(){orb.classList.remove('pulse');void orb.offsetWidth;orb.classList.add('pulse');try{navigator.vibrate&&navigator.vibrate(15)}catch(e){}}
function hasKey(){try{return !!Android.getKey()}catch(e){return false}}
const welcome=add('','ai');
function renderChips(){chips.innerHTML='';t().ideas.forEach(i=>{const b=document.createElement('button');b.type='button';b.className='chip';b.textContent=i;b.onclick=()=>{pulse();ask(i)};chips.appendChild(b)})}
function applyLang(){
  document.documentElement.lang=lang;langBtn.textContent=lang.toUpperCase();
  $('sub').textContent=t().sub;q.placeholder=t().ph;$('setupText').textContent=t().setup;$('saveKey').textContent=t().save;
  if(!history.length){welcome.textContent=t().hello;renderChips()}
}
langBtn.onclick=()=>{if(micOn){try{Android.stopMic()}catch(e){}}lang=lang==='id'?'en':'id';try{localStorage.setItem('lang',lang)}catch(e){}applyLang()};
applyLang();
if(!hasKey())setup.style.display='block';
$('gear').onclick=()=>{setup.style.display=setup.style.display==='block'?'none':'block'};
$('saveKey').onclick=()=>{try{Android.setKey(keyIn.value);keyIn.value='';setup.style.display='none';add(t().saved,'ai')}catch(e){}};
orb.onclick=()=>{pulse();if(!q.value.trim()){q.focus();q.placeholder=t().try+t().ideas[Math.floor(Math.random()*4)]}else ask(q.value)};
mic.onclick=()=>{try{micOn?Android.stopMic():Android.startMic(SR[lang])}catch(e){}};
window.onMicState=s=>{
  micOn=s==='listening';mic.classList.toggle('on',micOn);
  if(micOn)q.placeholder=t().listen;else q.placeholder=t().ph;
  if(s==='denied')add(t().denied,'ai');
  if(s==='unavailable')add(t().na,'ai');
  if(s==='error')add(t().micErr,'ai');
};
window.onMicResult=(text,final)=>{q.value=text;q.style.height='auto';q.style.height=Math.min(q.scrollHeight,120)+'px';if(final)q.focus()};
function ask(text){
  text=text.trim();if(!text||busy)return;
  if(!hasKey()){setup.style.display='block';return}
  chips.style.display='none';q.value='';q.style.height='auto';
  add(text,'me');history.push({role:'user',content:text});
  const out=add('…','ai'),id=nextId++;pending[id]=out;
  busy=true;send.disabled=true;orb.classList.add('think');
  Android.ask(id,JSON.stringify(history),lang);
}
window.onAnswer=function(id,text,err){
  const out=pending[id];delete pending[id];
  if(err){out.textContent=t().err+err;history.pop()}
  else{out.textContent=text;history.push({role:'assistant',content:text})}
  busy=false;send.disabled=false;orb.classList.remove('think');chat.scrollTop=chat.scrollHeight;
};
$('f').onsubmit=e=>{e.preventDefault();ask(q.value)};
q.addEventListener('input',()=>{q.style.height='auto';q.style.height=Math.min(q.scrollHeight,120)+'px'});
</script>
</body>
</html>
